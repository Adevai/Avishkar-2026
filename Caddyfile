# S.P.A.R.K. reverse proxy — automatic HTTPS via Let's Encrypt.
# Deploy: copy to /etc/caddy/Caddyfile on the host, point DNS, reload caddy.

{$SITE_DOMAIN:localhost} {
	# Reverse-proxy the Express app (frontend + API single origin)
	reverse_proxy localhost:5000

	# Server-Sent Events: disable buffering / timeouts on the event stream
	@sse path /api/events
	reverse_proxy @sse localhost:5000 {
		flush_interval -1
		transport http {
			response_header_timeout 24h
		}
	}

	# Sensible security headers (app sets the rest)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Gzip/zstd dynamic compression
	encode zstd gzip

	log {
		output file /var/log/caddy/spark-access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
